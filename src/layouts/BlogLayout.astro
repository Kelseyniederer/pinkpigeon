---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout>
  <section>
    <div class="pt-8 pb-24">
      <div class="lg:text-center">
        <div class="max-w-xl mx-auto">
          <h1
            class="text-4xl text-balance font-medium font-display text-base-900 dark:text-base-100"
          >
            {frontmatter.title}
          </h1>
          <p class="max-w-2xl mx-auto mt-4 text-base-500 dark:text-base-400 text-sm text-balance">
            <em>{frontmatter.description}</em>
          </p>
        </div>
        <Image
          width={1280}
          height={720}
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          class="object-cover object-center w-full aspect-12/7 rounded-xl mt-4"
        />
        <div class="flex flex-col justify-between mt-4 md:flex-row">
          <p class="text-xs text-base-500 dark:text-base-400">
            {frontmatter.pubDate.toString().slice(0, 10)} - Written by: {
              frontmatter.author
            }
          </p>
          <div class="flex gap-3">
            {
              frontmatter.tags.map((tag) => (
                <span class="hover:text-[var(--color-accent)] text-xs font-medium text-base-600 dark:text-base-400">
                  <a href={`/tags/${tag}`}>{tag}</a>
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <div class="prose prose-sm dark:prose-invert max-w-md mt-12 mx-auto">
        <slot />
      </div>

      {frontmatter.gallery && frontmatter.gallery.length > 0 && (
        <div class="max-w-2xl mx-auto mt-12">
          <div class="columns-2 sm:columns-3 gap-3 space-y-3">
            {frontmatter.gallery.map((photo) => (
              <button
                class="w-full break-inside-avoid cursor-zoom-in"
                data-lightbox={photo.url}
                aria-label={photo.alt || "View photo"}
              >
                <Image
                  src={photo.url}
                  alt={photo.alt || ""}
                  width={800}
                  height={800}
                  class="w-full rounded-lg object-cover"
                />
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4" role="dialog" aria-modal="true">
  <button id="lightbox-close" class="absolute top-4 right-5 text-white text-3xl leading-none" aria-label="Close">&times;</button>
  <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full rounded-lg object-contain" />
</div>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;

  function open(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const img = btn.querySelector("img");
      open(img?.src || "", img?.alt || "");
    });
  });

  document.getElementById("lightbox-close")!.addEventListener("click", close);

  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
